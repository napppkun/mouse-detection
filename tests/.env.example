BASE_URL=https://your-domain.com

# Admin account for UAT-USER tests
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=your_admin_password

# Regular user account
USER_EMAIL=test_user@test.com
USER_PASSWORD=your_user_password

# Target user for role change / delete tests
TARGET_USER_EMAIL=targetuser@test.com

# Mouse codes for tests
TEST_MOUSE_CODE=        # existing mouse 
DELETE_MOUSE_CODE=      # mouse prepared specifically for delete test

# Test videos (absolute path)
EPM_VIDEO_PATH=path/to/your/epm_test.mp4
YMAZE_VIDEO_PATH=path/to/your/ymaze_test.mp4
MWM_VIDEO_PATH=path/to/your/mwm_test.mp4

# Test data (must exist in DB before running)
TEST_DATE=
TEST_GROUP=
TEST_MOUSE_CODE_EPM=
TEST_MOUSE_CODE_YMAZE=
TEST_MOUSE_CODE_MWM=